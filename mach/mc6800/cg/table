		"\tldaa #[$1].h"
					| %[a] | |
loc $1!=0 && ($1%256)==($1>>8)	| |
		allocate(R16)
		"! loc high==low"
		"\tldab #[$1].l"
		"\ttba"
					| %[a] | |
