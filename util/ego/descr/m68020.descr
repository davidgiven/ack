#include "em_mnem.h"

word_size = 4;
pointer_size = 4;

register_allocation = {
    registers = {
        general = 5;
        pointer = 4;
        float = 0;
        general_as_pointer = false;
    };
    /* Rules are tested in order; the final rule must be "default".
     * Each cost has separate time and space estimates. */
    scores = {
        local_variable = (
            {
                from = "pointer";
                to = "pointer";
                rules = ( { when = "default"; time = 6; space = 4; } );
            },
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 4; space = 2; } );
            }
        );
        local_address = (
            {
                from = "pointer";
                to = "pointer";
                rules = ( { when = "default"; time = 0; space = 0; } );
            },
            {
                from = "general";
                to = "pointer";
                rules = ( { when = "default"; time = 1; space = 2; } );
            }
        );
        constant = (
            { when = "in_0_8"; time = -1; space = -1; },
            { when = "fitbyte"; time = -1; space = -1; },
            { when = "default"; time = -1; space = -1; }
        );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 1; space = 4; } );
        procedure_address = ( { when = "default"; time = 1; space = 4; } );
    };
    opening_costs = {
        local_variable = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 6; space = 4; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 6; space = 4; } );
            }
        );
        local_address = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 4; space = 4; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 4; space = 4; } );
            }
        );
        constant = (
            { when = "fitbyte"; time = 1000; space = 1000; },
            { when = "default"; time = 1000; space = 1000; }
        );
        double_constant = ( { when = "default"; time = 1000; space = 1000; } );
        global_address = ( { when = "default"; time = 6; space = 6; } );
        procedure_address = ( { when = "default"; time = 6; space = 6; } );
    };
    /* Indexed by total registers saved, starting at zero. */
    save_costs = (
        { time = 0; space = 0; },
        { time = 12; space = 6; },
        { time = 24; space = 10; },
        { time = 34; space = 10; },
        { time = 42; space = 10; },
        { time = 50; space = 10; },
        { time = 58; space = 10; },
        { time = 66; space = 10; },
        { time = 74; space = 10; },
        { time = 82; space = 10; },
        { time = 0; space = 0; }
    );
};

constant_propagation = {
    global_access = ( { when = "default"; time = 7; space = 4; } );
    local_access = ( { when = "default"; time = 4; space = 2; } );
};

strength_reduction = {
    overflow_harmful = false;
    array_bounds_harmful = false;
    shift_threshold = 3;
};

common_subexpressions = {
    time = {
        addressing_modes = [ op_ads, op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_ciu, op_cui, op_cuu, op_cmi, op_cmu, op_cmp ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [ 1, 2, 3 ];
        forbidden_operations = [];
    };
    space = {
        addressing_modes = [ op_ads, op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_ciu, op_cui, op_cuu, op_cmi, op_cmu, op_cmp ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [ 1, 2, 3 ];
        forbidden_operations = [];
    };
    indirection_limit = 8;
};

stack_pollution = {
    global_allowed = true;
};
