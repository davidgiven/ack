#include "em_mnem.h"

word_size = 4;
pointer_size = 4;

register_allocation = {
    registers = {
        general = 8;
        pointer = 0;
        float = 0;
        general_as_pointer = true;
    };
    /* Rules are tested in order; the final rule must be "default".
     * Each cost has separate time and space estimates. */
    scores = {
        local_variable = (
            {
                from = "pointer";
                to = "general";
                rules = (
                    { when = "fitbyte"; time = 5; space = 2; },
                    { when = "default"; time = 4; space = 3; }
                );
            },
            {
                from = "general";
                to = "general";
                rules = (
                    { when = "fitbyte"; time = 3; space = 1; },
                    { when = "default"; time = 2; space = 2; }
                );
            }
        );
        local_address = (
            {
                from = "pointer";
                to = "general";
                rules = (
                    { when = "fitbyte"; time = 0; space = 1; },
                    { when = "default"; time = 0; space = 2; }
                );
            },
            {
                from = "general";
                to = "general";
                rules = (
                    { when = "fitbyte"; time = 0; space = 1; },
                    { when = "default"; time = 0; space = 2; }
                );
            }
        );
        constant = (
            { when = "in_0_63"; time = 0; space = 0; },
            { when = "fitbyte"; time = 0; space = 1; },
            { when = "default"; time = 1; space = 2; }
        );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 2; space = 4; } );
        procedure_address = ( { when = "default"; time = 2; space = 4; } );
    };
    opening_costs = {
        local_variable = (
            {
                register_class = "pointer";
                rules = (
                    { when = "fitbyte"; time = 10; space = 4; },
                    { when = "default"; time = 9; space = 5; }
                );
            },
            {
                register_class = "general";
                rules = (
                    { when = "fitbyte"; time = 8; space = 4; },
                    { when = "default"; time = 7; space = 5; }
                );
            }
        );
        local_address = (
            {
                register_class = "pointer";
                rules = (
                    { when = "fitbyte"; time = 0; space = 4; },
                    { when = "default"; time = 0; space = 5; }
                );
            },
            {
                register_class = "general";
                rules = (
                    { when = "fitbyte"; time = 0; space = 4; },
                    { when = "default"; time = 0; space = 5; }
                );
            }
        );
        constant = (
            { when = "in_0_63"; time = 4; space = 2; },
            { when = "fitbyte"; time = 5; space = 3; },
            { when = "default"; time = 6; space = 4; }
        );
        double_constant = ( { when = "default"; time = 1000; space = 1000; } );
        global_address = ( { when = "default"; time = 6; space = 7; } );
        procedure_address = ( { when = "default"; time = 6; space = 7; } );
    };
    /* Indexed by total registers saved, starting at zero. */
    save_costs = (
        { time = 0; space = 0; },
        { time = 1; space = 0; },
        { time = 2; space = 0; },
        { time = 3; space = 0; },
        { time = 4; space = 0; },
        { time = 5; space = 0; },
        { time = 6; space = 0; },
        { time = 7; space = 0; },
        { time = 8; space = 0; },
        { time = 0; space = 0; }
    );
};

constant_propagation = {
    global_access = ( { when = "default"; time = 7; space = 4; } );
    local_access = (
        { when = "fitbyte"; time = 3; space = 1; },
        { when = "default"; time = 2; space = 2; }
    );
};

strength_reduction = {
    overflow_harmful = false;
    array_bounds_harmful = false;
    shift_threshold = 3;
};

common_subexpressions = {
    time = {
        addressing_modes = [ op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_cui, op_cfi, op_ciu, op_cff, op_cuu, op_cif, op_cmi, op_cmu, op_cmf, op_cms, op_cmp ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [ 1, 2, 3 ];
        forbidden_operations = [];
    };
    space = {
        addressing_modes = [ op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_cui, op_cfi, op_ciu, op_cff, op_cuu, op_cif, op_cmi, op_cmu, op_cmf, op_cms, op_cmp ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [ 1, 2, 3 ];
        forbidden_operations = [];
    };
    indirection_limit = 8;
};

stack_pollution = {
    global_allowed = true;
};
