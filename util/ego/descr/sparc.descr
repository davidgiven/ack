#include "em_mnem.h"

word_size = 4;
pointer_size = 4;

register_allocation = {
    registers = {
        general = 12;
        pointer = 0;
        float = 16;
        general_as_pointer = true;
    };
    /* Rules are tested in order; the final rule must be "default".
     * Each cost has separate time and space estimates. */
    scores = {
        local_variable = (
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 2; space = 1; } );
            },
            {
                from = "pointer";
                to = "general";
                rules = ( { when = "default"; time = 2; space = 1; } );
            },
            {
                from = "float";
                to = "float";
                rules = ( { when = "default"; time = 2; space = 1; } );
            }
        );
        local_address = (
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = -1; space = -1; } );
            }
        );
        constant = ( { when = "default"; time = -1; space = -1; } );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 1; space = 1; } );
        procedure_address = ( { when = "default"; time = -1; space = -1; } );
    };
    opening_costs = {
        local_variable = (
            {
                register_class = "general";
                rules = ( { when = "default"; time = 2; space = 1; } );
            },
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 2; space = 1; } );
            }
        );
        local_address = (
            {
                register_class = "general";
                rules = ( { when = "default"; time = -1; space = -1; } );
            }
        );
        constant = ( { when = "default"; time = -1; space = -1; } );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 2; space = 2; } );
        procedure_address = ( { when = "default"; time = -1; space = -1; } );
    };
    /* Indexed by total registers saved, starting at zero.
     * Cover all 12 general and 16 floating-point registers. */
    save_costs = (
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; },
        { time = 0; space = 0; }
    );
};

constant_propagation = {
    global_access = ( { when = "default"; time = 3; space = 2; } );
    local_access = ( { when = "default"; time = 2; space = 1; } );
};

strength_reduction = {
    overflow_harmful = false;
    array_bounds_harmful = true;
    shift_threshold = 0;
};

common_subexpressions = {
    time = {
        addressing_modes = [];
        cheap_operations = [ op_cuu, op_ciu, op_cui, op_cii ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [];
        forbidden_operations = [];
    };
    space = {
        addressing_modes = [];
        cheap_operations = [ op_cuu, op_ciu, op_cui, op_cii ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [];
        forbidden_operations = [];
    };
    indirection_limit = 8;
};

stack_pollution = {
    global_allowed = true;
};
