#include "em_mnem.h"

word_size = 2;
pointer_size = 2;

register_allocation = {
    registers = {
        general = 2;
        pointer = 0;
        float = 0;
        general_as_pointer = true;
    };
    /* Rules are tested in order; the final rule must be "default".
     * Each cost has separate time and space estimates. */
    scores = {
        local_variable = (
            {
                from = "pointer";
                to = "general";
                rules = ( { when = "default"; time = 8; space = 4; } );
            },
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 4; space = 2; } );
            }
        );
        local_address = (
            {
                from = "pointer";
                to = "general";
                rules = ( { when = "default"; time = 0; space = 0; } );
            },
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 2; space = 2; } );
            }
        );
        constant = ( { when = "default"; time = 2; space = 2; } );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 4; space = 2; } );
        procedure_address = ( { when = "default"; time = 2; space = 2; } );
    };
    opening_costs = {
        local_variable = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 9; space = 4; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 9; space = 4; } );
            }
        );
        local_address = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 10; space = 6; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 10; space = 6; } );
            }
        );
        constant = ( { when = "default"; time = 4; space = 4; } );
        double_constant = ( { when = "default"; time = 1000; space = 1000; } );
        global_address = ( { when = "default"; time = 4; space = 4; } );
        procedure_address = ( { when = "default"; time = 4; space = 4; } );
    };
    /* Indexed by total registers saved, starting at zero. */
    save_costs = (
        { time = 0; space = 0; },
        { time = 18; space = 2; },
        { time = 36; space = 4; },
        { time = 0; space = 0; }
    );
};

constant_propagation = {
    global_access = ( { when = "default"; time = 4; space = 2; } );
    local_access = ( { when = "default"; time = 4; space = 2; } );
};

strength_reduction = {
    overflow_harmful = false;
    array_bounds_harmful = false;
    shift_threshold = 0;
};

common_subexpressions = {
    time = {
        addressing_modes = [ op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_cui, op_ciu, op_cuu ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [];
        forbidden_operations = [];
    };
    space = {
        addressing_modes = [ op_adp, op_lof, op_ldf, op_loi, op_dch, op_lpb ];
        cheap_operations = [ op_cii, op_cui, op_ciu, op_cuu ];
        lexical_threshold = 1;
        convert_remainder_to_division = false;
        excluded_index_shift_counts = [];
        forbidden_operations = [];
    };
    indirection_limit = 8;
};

stack_pollution = {
    global_allowed = false;
};
