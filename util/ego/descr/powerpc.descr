#include "em_mnem.h"

word_size = 4;
pointer_size = 4;

register_allocation = {
    registers = {
        general = 19;
        pointer = 0;
        float = 18;
        general_as_pointer = true;
    };
    /* Rules are tested in order; the final rule must be "default".
     * Each cost has separate time and space estimates. */
    scores = {
        local_variable = (
            {
                from = "pointer";
                to = "general";
                rules = ( { when = "default"; time = 3; space = 4; } );
            },
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 3; space = 4; } );
            },
            {
                from = "float";
                to = "float";
                rules = ( { when = "default"; time = 5; space = 4; } );
            }
        );
        local_address = (
            {
                from = "pointer";
                to = "general";
                rules = ( { when = "default"; time = 0; space = 0; } );
            },
            {
                from = "general";
                to = "general";
                rules = ( { when = "default"; time = 0; space = 0; } );
            },
            {
                from = "float";
                to = "float";
                rules = ( { when = "default"; time = 0; space = 0; } );
            }
        );
        constant = (
            { when = "fitbyte"; time = -1; space = -1; },
            { when = "default"; time = -1; space = -1; }
        );
        double_constant = ( { when = "default"; time = -1; space = -1; } );
        global_address = ( { when = "default"; time = 2; space = 8; } );
        procedure_address = ( { when = "default"; time = -1; space = -1; } );
    };
    opening_costs = {
        local_variable = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 3; space = 4; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 3; space = 4; } );
            },
            {
                register_class = "float";
                rules = ( { when = "default"; time = 5; space = 4; } );
            }
        );
        local_address = (
            {
                register_class = "pointer";
                rules = ( { when = "default"; time = 1; space = 4; } );
            },
            {
                register_class = "general";
                rules = ( { when = "default"; time = 1; space = 4; } );
            },
            {
                register_class = "float";
                rules = ( { when = "default"; time = 1; space = 4; } );
            }
        );
        constant = (
            { when = "fitbyte"; time = 1000; space = 1000; },
            { when = "default"; time = 1000; space = 1000; }
        );
        double_constant = ( { when = "default"; time = 1000; space = 1000; } );
        global_address = ( { when = "default"; time = 2; space = 8; } );
        procedure_address = ( { when = "default"; time = 1000; space = 1000; } );
    };
    /* Indexed by total registers saved, starting at zero. */
    save_costs = (
        { time = 0; space = 0; },
        { time = 6; space = 8; },
        { time = 12; space = 16; },
        { time = 18; space = 24; },
        { time = 24; space = 32; },
        { time = 30; space = 40; },
        { time = 36; space = 48; },
        { time = 42; space = 56; },
        { time = 48; space = 64; },
        { time = 54; space = 72; },
        { time = 60; space = 80; },
        { time = 66; space = 88; },
        { time = 72; space = 96; },
        { time = 78; space = 104; },
        { time = 84; space = 112; },
        { time = 90; space = 120; },
        { time = 96; space = 128; },
        { time = 102; space = 136; },
        { time = 108; space = 144; },
        { time = 114; space = 152; },
        { time = 120; space = 160; },
        { time = 126; space = 168; },
        { time = 132; space = 176; },
        { time = 138; space = 184; },
        { time = 144; space = 192; },
        { time = 150; space = 200; },
        { time = 156; space = 208; },
        { time = 162; space = 216; },
        { time = 168; space = 224; },
        { time = 174; space = 232; },
        { time = 180; space = 240; },
        { time = 186; space = 248; },
        { time = 192; space = 256; },
        { time = 198; space = 264; },
        { time = 204; space = 272; },
        { time = 210; space = 280; },
        { time = 216; space = 288; },
        { time = 222; space = 296; },
        { time = 0; space = 0; }
    );
};

constant_propagation = {
    global_access = ( { when = "default"; time = 5; space = 12; } );
    local_access = ( { when = "default"; time = 3; space = 4; } );
};

strength_reduction = {
    overflow_harmful = false;
    array_bounds_harmful = true;
    shift_threshold = 0;
};

